<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Needed with the hardened runtime so the app may ask for the microphone. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Electron's V8 needs these under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Ad-hoc signatures carry no Team ID, so library validation would refuse to load Electron
         Framework ("different Team IDs"). Needed until the app is signed with a Developer ID. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
