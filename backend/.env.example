OPENAI_API_KEY=
# Leave unset to use gpt-transcribe, the only model family that takes the Chinese, English and
# Hindi language list. gpt-4o-transcribe drops fillers and translates mixed speech more often.
# TRANSCRIPTION_MODEL=gpt-transcribe
REFINEMENT_MODEL=gpt-4.1
# Second transcription used only to keep names in the language they were spoken in
# (纽约大学 said in Mandarin inside an English sentence). Leave empty to turn it off.
# NAME_CHECK_MODEL=gpt-4o-transcribe
PORT=3001
CORS_ORIGINS=http://localhost:5173
# Set to production on the hosted server. The server then refuses to start
# without OPENAI_API_KEY and CORS_ORIGINS, and CORS origins must use https.
NODE_ENV=development
# Number of proxies in front of the server (for example on Render), so usage
# limits see each visitor's address. Leave empty when running locally.
TRUST_PROXY=
# Optional Redis URL for the usage counters, so they survive restarts.
REDIS_URL=
# Usage limits (defaults shown). See docs/deployment.md.
# PROCESS_LIMIT_PER_MINUTE=5
# PROCESS_LIMIT_PER_DAY=30
# PROCESS_LIMIT_GLOBAL_PER_DAY=100
# REFINE_LIMIT_PER_MINUTE=10
# REFINE_LIMIT_PER_DAY=60
# REFINE_LIMIT_GLOBAL_PER_DAY=100
# MAX_CONCURRENT_REQUESTS=4
# MAX_CONCURRENT_PER_CLIENT=2
